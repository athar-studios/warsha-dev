diff --git a/src/domain.rs b/src/domain.rs
new file mode 100644
index 0000000..6ec8926
--- /dev/null
+++ b/src/domain.rs
@@ -0,0 +1,10 @@
+pub struct Money {
+    pub cents: i64,
+}
+
+impl Money {
+    pub fn checked_add(self, other: Money) -> Option<Money> {
+        let total = self.cents.checked_add(other.cents)?;
+        Some(Money { cents: total })
+    }
+}
diff --git a/src/engine.rs b/src/engine.rs
new file mode 100644
index 0000000..fb6c811
--- /dev/null
+++ b/src/engine.rs
@@ -0,0 +1,11 @@
+pub fn apply_fee(amount: i64, bps: u32) -> Option<i64> {
+    if bps > 10000 {
+        return None;
+    }
+    let fee = match (amount.unsigned_abs() as u128).checked_mul(u128::from(bps)) {
+        Some(product) => product / 10000,
+        None => return None,
+    };
+    let signed_fee = if amount < 0 { -(fee as i64) } else { fee as i64 };
+    amount.checked_add(signed_fee)
+}
